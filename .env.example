DATABASE_URL=postgres://coach:coach@localhost:5432/coach
JWT_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:3000
PORT=4000
# Phase 3
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Second LLM provider (Google Gemini API, key from https://aistudio.google.com/apikey).
# LLM_PROVIDER=auto uses Claude when ANTHROPIC_API_KEY is set, otherwise Gemini.
GEMINI_API_KEY=
LLM_PROVIDER=auto
# Optional model overrides (defaults: gemini-2.5-flash-lite / gemini-2.5-flash)
GEMINI_MODEL_FAST=
GEMINI_MODEL_SMART=
# Password shared by all seeded demo accounts
SEED_PASSWORD=demo-password
# One-click demo logins (public demo only)
DEMO_LOGIN_ENABLED=true
# Worker: replace all data with a fresh seed every day at 04:00 UTC (public demo only)
DEMO_DAILY_RESEED=false
# Web (Next.js): where /api/* is proxied to. Read at build time.
API_URL=http://localhost:4000
